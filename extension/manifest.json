{
  "manifest_version": 3,
  "name": "zoope",
  "version": "1.0.0",
  "description": "Lets your zoope avatar join Zoom, Google Meet and Microsoft Teams meetings in their web apps, with your face and voice.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://*.zoom.us/*",
    "https://zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"],
      "js": ["platforms.js", "meeting.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://localhost/*", "http://127.0.0.1/*",
        "https://*.github.io/*", "https://*.pages.dev/*", "https://*.netlify.app/*", "https://*.vercel.app/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["https://meet.google.com/*", "https://*.zoom.us/*", "https://zoom.us/*", "https://teams.microsoft.com/*", "https://teams.live.com/*"]
    }
  ],
  "icons": { "128": "icon.png" }
}
